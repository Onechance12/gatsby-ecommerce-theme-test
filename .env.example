JOBNIMBUS_API_BASE_URL=https://app.jobnimbus.com/api1
JOBNIMBUS_FILE_BASE_URL=https://app.jobnimbus.com/files
JOBNIMBUS_API_KEY=
JOBNIMBUS_BRIDGE_TOKEN=
CODEX_OPERATOR_TOKEN=
CODEX_MAC_OPERATOR_TOKEN=
BRIDGE_ALLOW_WRITES=false
HCN_ACTION_EXECUTION_ENABLED=false
HCN_SERVICE_NAME=hcn-operations-platform
# Required HCN-only persistent root. Do not point this at any Chance Brain,
# legacy-memory, or Jobrolo directory.
HCN_OPERATIONS_ROOT=/var/data/hcn-operations
# Isolated Thresher operational state. Keep false everywhere except the
# dedicated HCN service. Exact "true" activates only encrypted, minimized,
# non-executing lifecycle records after all dedicated keys validate.
HCN_THRESHER_ENABLED=false
HCN_THRESHER_STORE_PATH=/var/data/hcn-operations/thresher/state.enc.json
HCN_THRESHER_STORE_KEY=
HCN_THRESHER_REFERENCE_KEY=
HCN_THRESHER_SIGNING_KEY=
MAX_CHATGPT_FILE_BYTES=8388608
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Dedicated HCN browser identity and employee connector OAuth client. Browser
# sign-in requests identity only; explicit provider linking requests Gmail
# modify for gated draft/send actions and Calendar read-only. Do not reuse the
# legacy Custom GPT/HP Google client.
HCN_GOOGLE_CLIENT_ID=
HCN_GOOGLE_CLIENT_SECRET=
CHANCE_GOOGLE_SUBJECT=
ALLOW_GOOGLE_USER_AUTH=true
GOOGLE_OAUTH_ALLOWED_DOMAIN=wavepa.com
HCN_ALLOW_ACTIVE_JOBNIMBUS_GOOGLE_USERS=true
WAVE_AUTH_USERS_JSON=
PUBLIC_BASE_URL=
GPT_OAUTH_CLIENT_ID=wave-jobnimbus-gpt
GPT_OAUTH_CLIENT_SECRET=
# Generate at least 32 random bytes and store the base64url-encoded value.
OAUTH_SESSION_SECRET=
HCN_CONSOLE_ENABLED=false
HCN_CONSOLE_ORIGIN=
# HCN-only opaque reference namespace. Generate a random tenant id once and
# store 32-128 random key bytes as canonical, unpadded base64url.
HCN_TENANT_ID=
HCN_REFERENCE_KEY=
# Embedded HCN assistant. Use a dedicated OpenAI project key; do not reuse
# OPENAI_API_KEY (realtime voice) or any HCN/Chance Brain credential.
HCN_ASSISTANT_ENABLED=false
HCN_ASSISTANT_OPENAI_API_KEY=
# Reasoning profiles are fixed in server code: in Auto mode, routine exact
# reads bypass the model; ordinary reasoning uses Sol/medium, and Deep Review
# uses Sol/high.
# Dedicated HCN employee Google-grant encryption key. Generate 32-128 random
# bytes as canonical, unpadded base64url; never reuse another app secret.
HCN_GOOGLE_GRANT_KEY=
HCN_GOOGLE_GRANT_STORE_PATH=/var/data/hcn-operations/platform/google-grants.enc.json
AUTO_ENROLL_WAVE_USERS=false
HCN_IDENTITY_PIN_STORE_PATH=/var/data/hcn-operations/platform/identity-pins.json
GMAIL_USER=me
ALLOW_GMAIL_SEND=false
STANDARD_W9_GMAIL_MESSAGE_ID=
STANDARD_W9_GMAIL_ATTACHMENT_ID=
STANDARD_W9_SHA256=
QUO_API_KEY=
QUO_API_BASE_URL=https://api.quo.com/v1
QUO_DEFAULT_FROM_NUMBER=
ALLOW_QUO_SEND=false
GOOGLE_CALENDAR_ID=primary
SCHEDULING_HORIZON_DAYS=21
SCHEDULING_APPOINTMENT_MINUTES=120
SCHEDULING_TRAVEL_BUFFER_MINUTES=60
SCHEDULING_MIN_LEAD_HOURS=24
SCHEDULING_WORKDAY_START=08:00
SCHEDULING_WORKDAY_END=18:00
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
VOICE_PUBLIC_BASE_URL=
VOICE_STREAM_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com
QUO_VERIFICATION_FROM_NUMBER=
TWILIO_VERIFIED_TEST_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
ALLOW_VOICE_CALLS=false
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_HOMEOWNER_AGENT_ID=
RETELL_CLIENT_COORDINATOR_AGENT_ID=
RETELL_FROM_NUMBER=
ALLOW_RETELL_CALLS=false
ALLOW_CLIENT_COORDINATOR_CALLS=false
ALLOW_CARRIER_FOLLOWUP_CALLS=false
RETELL_CALLBACK_TTL_HOURS=72
CHANCE_JOBNIMBUS_OWNER_ID=fc95a213f70e4c9daddc5fa366be9941
HCN_MANAGEMENT_ADJUSTERS_JSON=
HCN_MANAGEMENT_MAX_FILES=300
HCN_MANAGEMENT_ACTIVITY_MAX_RECORDS=1000
HCN_MANAGEMENT_READ_CONCURRENCY=4
HCN_MANAGEMENT_PROVIDER_REQUEST_BUDGET=750
CLAIM_CALL_STORE_PATH=/var/data/hcn-operations/platform/claim-call-ledger.json
ACTION_BATCH_STORE_PATH=/var/data/hcn-operations/platform/action-batches.json
ACTION_APPROVAL_STORE_PATH=/var/data/hcn-operations/platform/action-approvals.json
HCN_ACTION_RECEIPT_STORE_PATH=/var/data/hcn-operations/platform/action-receipts.json
ACTION_APPROVAL_TTL_SECONDS=900
OUTBOUND_SEND_STORE_PATH=/var/data/hcn-operations/platform/outbound-sends.json
HCN_QUO_LINE_STORE_PATH=/var/data/hcn-operations/platform/quo-line-store.enc.json
# Dedicated encryption/OTP-MAC key for employee Quo authorization. Generate
# 32-128 random bytes as canonical, unpadded base64url; never reuse another key.
HCN_QUO_LINK_KEY=
