# JobNimbus API (create a key in JobNimbus settings under API)
JOBNIMBUS_USE_FIXTURES=true
JOBNIMBUS_API_BASE_URL=https://app.jobnimbus.com/api1
JOBNIMBUS_API_KEY=
JOBNIMBUS_AUTH_SCHEME=Bearer
JOBNIMBUS_ACTOR=

# Safety: JobNimbus writes stay dry-run unless this is true AND the command passes execute:true
ALLOW_JOBNIMBUS_WRITES=false

# Pagination
JOBNIMBUS_PAGE_SIZE=1000
JOBNIMBUS_MAX_OFFSET=100000
JOBNIMBUS_RESULT_WINDOW_LIMIT=10000

# Review tuning
JOBNIMBUS_STALE_DAYS=7
JOBNIMBUS_HIGH_PRIORITY_STALE_DAYS=14
# auto | company | chance
REVIEW_SCOPE=auto

# Endpoint overrides (defaults match the public JobNimbus API docs)
#JOBNIMBUS_CONTACTS_ENDPOINT=/contacts
#JOBNIMBUS_JOBS_ENDPOINT=/jobs
#JOBNIMBUS_TASKS_ENDPOINT=/tasks
#JOBNIMBUS_ACTIVITIES_ENDPOINT=/activities
#JOBNIMBUS_DOCUMENTS_ENDPOINT=/files
#JOBNIMBUS_PAYMENTS_ENDPOINT=/payments
#JOBNIMBUS_ACCOUNT_SETTINGS_ENDPOINT=/account/settings
#JOBNIMBUS_ACCOUNT_USERS_ENDPOINT=/account/users

# Chat bridge (npm run bridge) — required before exposing the bridge publicly
JOBNIMBUS_BRIDGE_TOKEN=
BRIDGE_ALLOW_WRITES=false
#PORT=8788

# OpenAI (voice agent + key test)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
#VOICE_AGENT_INSTRUCTIONS=

# Twilio (voice calls) — calls stay dry-run unless ALLOW_VOICE_CALLS=true AND execute:true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFIED_TEST_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_MEDIA_STREAM_URL=
ALLOW_VOICE_CALLS=false

# Voice bridge server (npm run voice:server)
VOICE_SERVER_PORT=8787
VOICE_PUBLIC_BASE_URL=
VOICE_STREAM_TOKEN=

# Google (Gmail + Drive) — see docs/google-setup.md. Mint refresh token: npm run google:oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Sending stays off — drafts only; Chance sends
ALLOW_GMAIL_SEND=false

# Quo (formerly OpenPhone) — company phone system (read: texts + call logs)
QUO_API_KEY=
QUO_API_BASE_URL=https://api.openphone.com/v1
